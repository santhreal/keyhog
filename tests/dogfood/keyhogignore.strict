# KeyHog STRICT repository dogfood policy.
#
# The operator lane (.keyhogignore) excludes five fixture-heavy trees
# wholesale: detectors/, crates/scanner/examples/, benchmarks/baselines/,
# benchmarks/generators/, and .github/workflows/integration-smoke.yml. A whole
# directory exclusion cannot tell an intentional fixture from a real leak, so
# this policy scans all five and suppresses only the exact reviewed values.
#
# Run it with tests/dogfood/strict_scan.sh. The lane plants an unmarked
# credential in each protected tree and fails if the scan does not report it,
# so the difference between `no findings` and `not scanned` stays observable.
#
# Same governance as the operator lane: every entry carries reason= and
# approved_by=, and tests/dogfood/suppression_audit.py enforces both.

# --- Reviewed fixtures in the trees this lane scans ---------------------------
hash:465148b75236ddfab10911fdb07ac84eca2c53aa8a5e4616f35fd56195e16ffb; reason="detector probe example fixture; measured generic-secret at crates/scanner/examples/scan_probe.rs:29, a second attribution of the same probe line at a different match extent"; approved_by="keyhog-maintainers"
