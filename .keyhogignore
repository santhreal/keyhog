# KeyHog repository dogfood policy (normal operator lane).
#
# Every entry carries `reason=` and `approved_by=` inline metadata, the
# governance trailer `keyhog_core::Allowlist` parses. `tests/dogfood/suppression_audit.py`
# fails the build when an entry lacks either field, when a literal `path:`
# entry stops resolving (a rename or module split silently voids it), and it
# reports every `hash:` entry that suppressed nothing.
#
# Two lanes consume repository policy, and they publish separate coverage
# manifests so neither can quietly omit a path:
#   * this file            - `tests/dogfood/repository_scan.sh` (operator policy)
#   * keyhogignore.strict  - `tests/dogfood/strict_scan.sh` (strict repository policy,
#                            scans detectors/, examples, baselines, generators, and
#                            workflow YAML that this lane excludes wholesale)
#
# Do not paste literal credential shapes into a comment here. This file is
# itself scanned by both lanes.

# --- Generated and external trees -------------------------------------------
# `reason=transient:` marks a path that is generated, gitignored, or an
# external corpus dropped in the tree. The auditor does not require these to
# exist; every other literal path must resolve.
path:.internal/; reason="transient: private internal notes and requirement ledgers, gitignored"; approved_by="keyhog-maintainers"
path:target/; reason="transient: cargo build output, gitignored"; approved_by="keyhog-maintainers"
path:site/; reason="transient: docs site regenerated from detectors/*.toml on every build; embeds each detector's example token"; approved_by="keyhog-maintainers"
path:ml/; reason="transient: model training scratch and datasets, not shipped source"; approved_by="keyhog-maintainers"
path:tools/secretbench/; reason="transient: retired SecretBench tree; only regenerable corpora and result dumps remain on disk"; approved_by="keyhog-maintainers"
path:benchmarks/corpora/; reason="transient: generated mirror corpora, reproducible with `make -C benchmarks mirror`, full of synthetic secret-shaped fixtures"; approved_by="keyhog-maintainers"
path:benchmarks/results/; reason="transient: per-run RunResult JSONs, reproducible with `make -C benchmarks bench`"; approved_by="keyhog-maintainers"

# --- Reviewed non-text release assets ---------------------------------------
# The default filesystem source does not scan their bytes as text, so dogfood
# names them explicitly instead of reporting an incomplete clean scan.
path:crates/scanner/data/english_bigram_logprob.bin; reason="reviewed binary model blob; not scanned as text, named explicitly so the lane never reports an incomplete clean"; approved_by="keyhog-maintainers"
path:crates/scanner/data/cl100k_base.tiktoken; reason="reviewed tokenizer rank table; vocabulary data is not source content and contains 489 high-entropy token fragments under the portable Action build"; approved_by="keyhog-maintainers"
path:crates/scanner/src/weights.bin; reason="reviewed binary ML weight blob; not scanned as text, named explicitly so the lane never reports an incomplete clean"; approved_by="keyhog-maintainers"
path:docs/assets/keyhog-banner.svg; reason="reviewed docs banner asset; not scanned as text, named explicitly so the lane never reports an incomplete clean"; approved_by="keyhog-maintainers"

# --- Documentation that quotes findings --------------------------------------
path:CHANGELOG.md; reason="release notes quote example credentials verbatim; documentation about findings, not live material"; approved_by="keyhog-maintainers"

# --- Test, fixture, and demo trees -------------------------------------------
# These trees carry exact positive and negative credential examples by design.
# The STRICT lane scans the fixture-heavy subset of them under an explicit
# fixture policy; see tests/dogfood/keyhogignore.strict.
path:demo/; reason="demo fixtures embed fake credentials so the TUI recording has content to scan"; approved_by="keyhog-maintainers"
path:crates/scanner/tests/fixtures/detector_execution_policy_utf8/; reason="regression fixture embeds fabricated passwords from the source that reproduced a UTF-8 span crash"; approved_by="keyhog-maintainers"
path:crates/core/tests/; reason="test fixtures carry exact positive and negative credential examples that prove detector behavior"; approved_by="keyhog-maintainers"
path:crates/cli/tests/; reason="test fixtures carry exact positive and negative credential examples that prove detector behavior"; approved_by="keyhog-maintainers"
path:crates/scanner/tests/; reason="test fixtures carry exact positive and negative credential examples that prove detector behavior"; approved_by="keyhog-maintainers"
path:crates/sources/tests/; reason="test fixtures carry exact positive and negative credential examples that prove detector behavior"; approved_by="keyhog-maintainers"
path:crates/verifier/tests/; reason="test fixtures carry exact positive and negative credential examples that prove detector behavior"; approved_by="keyhog-maintainers"
path:crates/scanner/benches/; reason="benchmark fixtures carry exact credential examples that prove detector behavior"; approved_by="keyhog-maintainers"
path:benchmarks/bench/tests/; reason="scorer tests carry exact credential examples that prove scoring behavior"; approved_by="keyhog-maintainers"
path:tests/dogfood/; reason="the dogfood lane's own fixtures and planted-secret probes live here"; approved_by="keyhog-maintainers"
path:tests/install/fixtures/install_from_local_build_posix.sh; reason="installer exercise decodes synthetic credentials so the freshly installed binary can prove detector coverage end to end"; approved_by="keyhog-maintainers"
path:crates/cli/data/suppressions/test-fixtures.toml; reason="the file's purpose is to enumerate known-public sample credentials so keyhog can suppress them by hash"; approved_by="keyhog-maintainers"
path:crates/scanner/examples/; reason="detector probe examples carry sample credentials by design; the strict lane scans them under an explicit fixture policy"; approved_by="keyhog-maintainers"
path:detectors/; reason="detector definitions carry example tokens by design; the strict lane scans them and currently reports zero findings"; approved_by="keyhog-maintainers"
path:benchmarks/baselines/; reason="committed differential baselines are keyhog's own redacted output plus TP/FP/FN comparison tables that quote surfaced shapes; the strict lane scans them under a redaction-aware policy"; approved_by="keyhog-maintainers"
path:benchmarks/generators/; reason="mirror generators assemble synthetic credentials at runtime to build benchmark fixtures; the strict lane scans the generator source"; approved_by="keyhog-maintainers"
path:.github/workflows/integration-smoke.yml; reason="the workflow base64-encodes planted vendor-doc fixtures so the runner can prove the scanner finds them; the strict lane scans workflow YAML by hash instead"; approved_by="keyhog-maintainers"

# --- Fixture-scoped hashes replacing former source-path suppressions ---------
# KH-576: `path:` entries hid whole production source files because they
# contain doc-comment fixtures. Measured on the release-fast build across the
# default, --no-decode, --fast, --precision, --deep, --no-default-excludes, and
# --git-history presets, four of those files (decode/reverse.rs,
# suppression/path_filter.rs, hosted_git/sanitize.rs, suppression/shape/canonical.rs)
# surface nothing at all, so their path entries are gone. The rest are scoped to
# the exact fixture value, which keeps the surrounding file scanned and fails the
# lane on any second credential planted in it.
hash:e51274cf409418544734e68fef141a841ca58b82a4d7e61f41b2ed638abfd902; reason="GPU ML-scorer warm sample; vendor example token used only to touch the feature extractor; measured entropy-api-key at /media/mukund-thiru/SanthData/Santh/software/keyhog/crates/scanner/src/gpu/backend/execution.rs:755; surfaced by preset(s) decode,deep,nodecode,noexcl"; approved_by="keyhog-maintainers"
hash:5cb35e896767fc86473c803ec5915fe272b73dcb274743e520c660d719d52ece; reason="benchmark smoke fixture; measured stripe-secret-key at crates/cli/src/benchmark.rs:115, fabricated vendor-docs shape"; approved_by="keyhog-maintainers"
hash:94ba8206be4dd790b4d3243a600904b91e210b7a3940f285559631d2079f0145; reason="shape-classifier accept fixture; measured entropy-token at crates/scanner/src/suppression/shape/canonical.rs:273 under --deep only"; approved_by="keyhog-maintainers"

